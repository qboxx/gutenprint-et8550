     <ChannelDensityParam name="BlackDensity"/>
    </subchannel>
   </channel>
   <channel name="claria_photo_black" index="5">
    <subchannel color="64" subchannel="0" headOffset="0" name="PhotoBlack" text="Photo Black" translate="text">
     <ChannelDensityParam name="BlackDensity"/>
    </subchannel>
   </channel>
  </Channels>
 </InkName>

</InkList>
</escp2InkGroup>
